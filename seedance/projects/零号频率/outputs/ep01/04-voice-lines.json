[
  {"lineIndex": 1, "speaker": "旁白", "content": "十万人在祈祷。", "emotionStrength": 0.1, "matchedPanel": {"storyboardId": "clip-01", "panelIndex": 0}},
  {"lineIndex": 2, "speaker": "旁白", "content": "今天是频率纪元第二十七年。圣辉教团史上最重要的一天。", "emotionStrength": 0.1, "matchedPanel": {"storyboardId": "clip-01", "panelIndex": 1}},
  {"lineIndex": 3, "speaker": "灵曦", "content": "从十九年前第一次被带进教团的那天起，她就知道自己存在的意义。所有的训练、所有的祈祷，都是为了此刻。降临。炽天使将通过她降临人间。她信。她真的信。", "emotionStrength": 0.1, "matchedPanel": {"storyboardId": "clip-01", "panelIndex": 4}},
  {"lineIndex": 4, "speaker": "大祭司光耀", "content": "光之子民！今日，我们将见证——", "emotionStrength": 0.2, "matchedPanel": {"storyboardId": "clip-01", "panelIndex": 5}},
  {"lineIndex": 5, "speaker": "旁白", "content": "炽天使。天使九品的至高位阶。这不是人类的力量。这是来自更高维度的、彻底碾压性的存在。", "emotionStrength": 0.15, "matchedPanel": {"storyboardId": "clip-01", "panelIndex": 6}},
  {"lineIndex": 6, "speaker": "大祭司光耀", "content": "他见过这个场面的排练版本。灵曦是第一个突破百分之四十的。她也将是第一个达到百分之一百的。到那时候，灵曦就不存在了。大祭司知道这一切。他策划了这一切。", "emotionStrength": 0.1, "matchedPanel": {"storyboardId": "clip-01", "panelIndex": 7}},
  {"lineIndex": 7, "speaker": "技术人员", "content": "同步率五十二……五十三……", "emotionStrength": 0.1, "matchedPanel": {"storyboardId": "clip-01", "panelIndex": 8}},
  {"lineIndex": 8, "speaker": "大祭司光耀", "content": "再给我三分钟。", "emotionStrength": 0.1, "matchedPanel": {"storyboardId": "clip-01", "panelIndex": 9}},
  {"lineIndex": 9, "speaker": "天使护卫", "content": "入侵者——！", "emotionStrength": 0.35, "matchedPanel": {"storyboardId": "clip-02", "panelIndex": 0}},
  {"lineIndex": 10, "speaker": "叶烬", "content": "嘿。", "emotionStrength": 0.1, "matchedPanel": {"storyboardId": "clip-02", "panelIndex": 3}},
  {"lineIndex": 11, "speaker": "叶烬", "content": "早上好，圣女大人。仪式取消了。", "emotionStrength": 0.15, "matchedPanel": {"storyboardId": "clip-02", "panelIndex": 6}},
  {"lineIndex": 12, "speaker": "叶烬", "content": "好快。", "emotionStrength": 0.1, "matchedPanel": {"storyboardId": "clip-02", "panelIndex": 6}},
  {"lineIndex": 13, "speaker": "灵曦", "content": "放开我！你知道你在做什么吗？你在亵渎——", "emotionStrength": 0.35, "matchedPanel": {"storyboardId": "clip-02", "panelIndex": 7}},
  {"lineIndex": 14, "speaker": "叶烬", "content": "我在救你的命。细节以后再说。现在——", "emotionStrength": 0.2, "matchedPanel": {"storyboardId": "clip-02", "panelIndex": 8}},
  {"lineIndex": 15, "speaker": "米迦勒持有者", "content": "放下圣女。这是你唯一的机会。", "emotionStrength": 0.25, "matchedPanel": {"storyboardId": "clip-02", "panelIndex": 9}},
  {"lineIndex": 16, "speaker": "叶烬", "content": "从来不是。", "emotionStrength": 0.15, "matchedPanel": {"storyboardId": "clip-02", "panelIndex": 10}},
  {"lineIndex": 17, "speaker": "灵曦", "content": "你到底是什么？我的审判之眼——我看不到你的频率属性。什么都看不到。", "emotionStrength": 0.25, "matchedPanel": {"storyboardId": "clip-03", "panelIndex": 1}},
  {"lineIndex": 18, "speaker": "叶烬", "content": "变了。", "emotionStrength": 0.1, "matchedPanel": {"storyboardId": "clip-03", "panelIndex": 2}},
  {"lineIndex": 19, "speaker": "彼列持有者", "content": "噢。看来我们不是唯一想抢这笔买卖的人。", "emotionStrength": 0.2, "matchedPanel": {"storyboardId": "clip-03", "panelIndex": 4}},
  {"lineIndex": 20, "speaker": "灵曦", "content": "你……", "emotionStrength": 0.3, "matchedPanel": {"storyboardId": "clip-03", "panelIndex": 5}},
  {"lineIndex": 21, "speaker": "彼列持有者", "content": "别激动，甜心。我们只是来完成工作的。杀死你——阻止炽天使降临——对每个人都好。嗯，除了你。", "emotionStrength": 0.2, "matchedPanel": {"storyboardId": "clip-03", "panelIndex": 6}},
  {"lineIndex": 22, "speaker": "叶烬", "content": "三打一？还是三打二？如果你算她的话。虽然她现在大概更想打我。", "emotionStrength": 0.15, "matchedPanel": {"storyboardId": "clip-03", "panelIndex": 7}},
  {"lineIndex": 23, "speaker": "叶烬", "content": "跑。", "emotionStrength": 0.2, "matchedPanel": {"storyboardId": "clip-03", "panelIndex": 8}},
  {"lineIndex": 24, "speaker": "彼列持有者", "content": "追。圣女必须死——不管先杀谁。", "emotionStrength": 0.3, "matchedPanel": {"storyboardId": "clip-03", "panelIndex": 8}},
  {"lineIndex": 25, "speaker": "灵曦", "content": "放手！我自己能跑！", "emotionStrength": 0.3, "matchedPanel": {"storyboardId": "clip-04", "panelIndex": 2}},
  {"lineIndex": 26, "speaker": "叶烬", "content": "随你。跟紧，往西。", "emotionStrength": 0.15, "matchedPanel": {"storyboardId": "clip-04", "panelIndex": 3}},
  {"lineIndex": 27, "speaker": "灵曦", "content": "你闯入仪式，打断了降临——我为什么要跟你走？", "emotionStrength": 0.3, "matchedPanel": {"storyboardId": "clip-04", "panelIndex": 4}},
  {"lineIndex": 28, "speaker": "叶烬", "content": "后面的恶魔想杀你。", "emotionStrength": 0.15, "matchedPanel": {"storyboardId": "clip-04", "panelIndex": 5}},
  {"lineIndex": 29, "speaker": "叶烬", "content": "你后面的那些天使——他们也不会让你活。", "emotionStrength": 0.2, "matchedPanel": {"storyboardId": "clip-04", "panelIndex": 6}},
  {"lineIndex": 30, "speaker": "叶烬", "content": "仪式中断了，你对教团来说已经从「容器」变成了「失败品」。你觉得他们会怎么处理一个用不上的容器？", "emotionStrength": 0.2, "matchedPanel": {"storyboardId": "clip-04", "panelIndex": 8}},
  {"lineIndex": 31, "speaker": "灵曦", "content": "……你在骗我。", "emotionStrength": 0.2, "matchedPanel": {"storyboardId": "clip-04", "panelIndex": 11}},
  {"lineIndex": 32, "speaker": "叶烬", "content": "你可以回去验证。但你只有一次机会。", "emotionStrength": 0.15, "matchedPanel": {"storyboardId": "clip-04", "panelIndex": 12}},
  {"lineIndex": 33, "speaker": "叶烬", "content": "不好搞。", "emotionStrength": 0.15, "matchedPanel": {"storyboardId": "clip-05", "panelIndex": 1}},
  {"lineIndex": 34, "speaker": "灵曦", "content": "你的计划不包括这个？", "emotionStrength": 0.2, "matchedPanel": {"storyboardId": "clip-05", "panelIndex": 2}},
  {"lineIndex": 35, "speaker": "叶烬", "content": "我的计划是在他们启动闭锁之前出城。多了几个变数。", "emotionStrength": 0.15, "matchedPanel": {"storyboardId": "clip-05", "panelIndex": 3}},
  {"lineIndex": 36, "speaker": "灵曦", "content": "这东西的发生器在城墙四个角各有一个节点。打掉任意一个，护盾就会出现缺口。", "emotionStrength": 0.15, "matchedPanel": {"storyboardId": "clip-05", "panelIndex": 4}},
  {"lineIndex": 37, "speaker": "叶烬", "content": "你怎么知道的？", "emotionStrength": 0.15, "matchedPanel": {"storyboardId": "clip-05", "panelIndex": 4}},
  {"lineIndex": 38, "speaker": "灵曦", "content": "我是圣女。教团的城防设施我全都参观过。实际上我记忆力很好。", "emotionStrength": 0.15, "matchedPanel": {"storyboardId": "clip-05", "panelIndex": 5}},
  {"lineIndex": 39, "speaker": "米迦勒持有者", "content": "圣女。离开那个异端。回到我身边。", "emotionStrength": 0.25, "matchedPanel": {"storyboardId": "clip-05", "panelIndex": 7}},
  {"lineIndex": 40, "speaker": "叶烬", "content": "你的大祭司知道降临仪式会杀了她吧？你也知道？", "emotionStrength": 0.2, "matchedPanel": {"storyboardId": "clip-05", "panelIndex": 8}},
  {"lineIndex": 41, "speaker": "彼列持有者", "content": "噢，天使大人也来了。这下可热闹了。", "emotionStrength": 0.2, "matchedPanel": {"storyboardId": "clip-05", "panelIndex": 11}},
  {"lineIndex": 42, "speaker": "米迦勒持有者", "content": "我不和恶魔合作。", "emotionStrength": 0.2, "matchedPanel": {"storyboardId": "clip-05", "panelIndex": 11}},
  {"lineIndex": 43, "speaker": "彼列持有者", "content": "那就各凭本事了。", "emotionStrength": 0.2, "matchedPanel": {"storyboardId": "clip-05", "panelIndex": 11}},
  {"lineIndex": 44, "speaker": "叶烬", "content": "灵曦！护盾节点——你去，我拖住他们！", "emotionStrength": 0.3, "matchedPanel": {"storyboardId": "clip-05", "panelIndex": 12}},
  {"lineIndex": 45, "speaker": "叶烬", "content": "能打就别愣着！", "emotionStrength": 0.3, "matchedPanel": {"storyboardId": "clip-05", "panelIndex": 15}},
  {"lineIndex": 46, "speaker": "米迦勒持有者", "content": "你的频率……不是天使，也不是恶魔。但两种都有。你到底是什么？", "emotionStrength": 0.25, "matchedPanel": {"storyboardId": "clip-06", "panelIndex": 1}},
  {"lineIndex": 47, "speaker": "叶烬", "content": "问这个问题的人太多了。我收会员费的话早就财务自由了。", "emotionStrength": 0.15, "matchedPanel": {"storyboardId": "clip-06", "panelIndex": 2}},
  {"lineIndex": 48, "speaker": "米迦勒持有者", "content": "承认吧。你一个人打不过我们所有人。你在等什么？", "emotionStrength": 0.25, "matchedPanel": {"storyboardId": "clip-06", "panelIndex": 4}},
  {"lineIndex": 49, "speaker": "叶烬", "content": "等你们互相打起来。", "emotionStrength": 0.15, "matchedPanel": {"storyboardId": "clip-06", "panelIndex": 5}},
  {"lineIndex": 50, "speaker": "彼列持有者", "content": "安度西亚斯——转向，追圣女。我来处理这个黑翼的。", "emotionStrength": 0.25, "matchedPanel": {"storyboardId": "clip-07", "panelIndex": 0}},
  {"lineIndex": 51, "speaker": "米迦勒持有者", "content": "你哪也去不了。", "emotionStrength": 0.25, "matchedPanel": {"storyboardId": "clip-07", "panelIndex": 1}},
  {"lineIndex": 52, "speaker": "彼列持有者", "content": "一对二。看看你还能耍多少花招。", "emotionStrength": 0.2, "matchedPanel": {"storyboardId": "clip-07", "panelIndex": 1}},
  {"lineIndex": 53, "speaker": "叶烬", "content": "不好意思，前面一直在热身。", "emotionStrength": 0.15, "matchedPanel": {"storyboardId": "clip-07", "panelIndex": 4}},
  {"lineIndex": 54, "speaker": "彼列持有者", "content": "零号频率。原来传说是真的。", "emotionStrength": 0.25, "matchedPanel": {"storyboardId": "clip-07", "panelIndex": 7}},
  {"lineIndex": 55, "speaker": "叶烬", "content": "你还要打？", "emotionStrength": 0.15, "matchedPanel": {"storyboardId": "clip-07", "panelIndex": 8}},
  {"lineIndex": 56, "speaker": "彼列持有者", "content": "告辞。我们会再见的，零号。", "emotionStrength": 0.2, "matchedPanel": {"storyboardId": "clip-07", "panelIndex": 9}},
  {"lineIndex": 57, "speaker": "安度西亚斯持有者", "content": "你比预想中能打。但你撑不了多久。半降临——频率不稳定，用一次少一次。", "emotionStrength": 0.2, "matchedPanel": {"storyboardId": "clip-07", "panelIndex": 11}},
  {"lineIndex": 58, "speaker": "叶烬", "content": "你用了百分之百。", "emotionStrength": 0.2, "matchedPanel": {"storyboardId": "clip-08", "panelIndex": 0}},
  {"lineIndex": 59, "speaker": "叶烬", "content": "走。出城。", "emotionStrength": 0.15, "matchedPanel": {"storyboardId": "clip-08", "panelIndex": 0}},
  {"lineIndex": 60, "speaker": "灵曦", "content": "消不掉了。", "emotionStrength": 0.2, "matchedPanel": {"storyboardId": "clip-08", "panelIndex": 2}},
  {"lineIndex": 61, "speaker": "叶烬", "content": "侵蚀度。每次使用都会留下一点。", "emotionStrength": 0.15, "matchedPanel": {"storyboardId": "clip-08", "panelIndex": 3}},
  {"lineIndex": 62, "speaker": "灵曦", "content": "你欠我一个解释。你打断了降临仪式。你说你在救我的命。为什么？", "emotionStrength": 0.25, "matchedPanel": {"storyboardId": "clip-08", "panelIndex": 4}},
  {"lineIndex": 63, "speaker": "叶烬", "content": "你知道降临仪式的过程吗？真实的过程。频率层面。炽天使频率和人体频率同步到百分之百的时候，不是「融合」。是覆写。你的记忆、你的性格、你的灵魂——全部删除，格式化。", "emotionStrength": 0.2, "matchedPanel": {"storyboardId": "clip-08", "panelIndex": 5}},
  {"lineIndex": 64, "speaker": "灵曦", "content": "你在说……降临仪式会杀了我。", "emotionStrength": 0.3, "matchedPanel": {"storyboardId": "clip-08", "panelIndex": 6}},
  {"lineIndex": 65, "speaker": "叶烬", "content": "不是「会」。是「就是在」。百分之五十六的时候我打断了。如果让它走到百分之一百——你就不在了。", "emotionStrength": 0.2, "matchedPanel": {"storyboardId": "clip-08", "panelIndex": 7}},
  {"lineIndex": 66, "speaker": "灵曦", "content": "你怎么知道的？", "emotionStrength": 0.2, "matchedPanel": {"storyboardId": "clip-08", "panelIndex": 8}},
  {"lineIndex": 67, "speaker": "叶烬", "content": "因为第一个容器叫苏菲。十七岁。我没来得及。", "emotionStrength": 0.2, "matchedPanel": {"storyboardId": "clip-08", "panelIndex": 9}},
  {"lineIndex": 68, "speaker": "灵曦", "content": "我需要时间。我需要——确认。", "emotionStrength": 0.2, "matchedPanel": {"storyboardId": "clip-08", "panelIndex": 10}},
  {"lineIndex": 69, "speaker": "叶烬", "content": "你有时间。但不是现在。现在我们得在教团的搜索队找到我们之前走远一点。", "emotionStrength": 0.15, "matchedPanel": {"storyboardId": "clip-08", "panelIndex": 11}},
  {"lineIndex": 70, "speaker": "灵曦", "content": "你还没回答我最重要的问题。你到底是什么？", "emotionStrength": 0.2, "matchedPanel": {"storyboardId": "clip-08", "panelIndex": 12}},
  {"lineIndex": 71, "speaker": "叶烬", "content": "零号。在天使和恶魔还不存在的时候，有一个人碰到了那个原始信号。在它分裂成两半之前。或者说——是他让它分裂成了两半。", "emotionStrength": 0.15, "matchedPanel": {"storyboardId": "clip-08", "panelIndex": 13}},
  {"lineIndex": 72, "speaker": "灵曦", "content": "所以你是……你是第一个？", "emotionStrength": 0.3, "matchedPanel": {"storyboardId": "clip-08", "panelIndex": 14}},
  {"lineIndex": 73, "speaker": "叶烬", "content": "最后再问你一次。你可以回去。回去当你的圣女。或者跟我走。", "emotionStrength": 0.15, "matchedPanel": {"storyboardId": "clip-08", "panelIndex": 15}},
  {"lineIndex": 74, "speaker": "彼列持有者", "content": "任务失败。圣女逃脱。安度西亚斯重伤，梦魇失踪。", "emotionStrength": 0.2, "matchedPanel": {"storyboardId": "clip-09", "panelIndex": 1}},
  {"lineIndex": 75, "speaker": "嫉妒冠持有者", "content": "不，不是失败。零号频率终于现身了。告诉傲慢冠——猎物比我们以为的更有价值。", "emotionStrength": 0.2, "matchedPanel": {"storyboardId": "clip-09", "panelIndex": 2}},
  {"lineIndex": 76, "speaker": "大祭司光耀", "content": "报告。", "emotionStrength": 0.1, "matchedPanel": {"storyboardId": "clip-10", "panelIndex": 1}},
  {"lineIndex": 77, "speaker": "灵曦", "content": "光耀爷爷，天使真的会来吗？", "emotionStrength": 0.15, "matchedPanel": {"storyboardId": "clip-10", "panelIndex": 2}},
  {"lineIndex": 78, "speaker": "大祭司光耀", "content": "零号频率。", "emotionStrength": 0.15, "matchedPanel": {"storyboardId": "clip-10", "panelIndex": 2}},
  {"lineIndex": 79, "speaker": "大祭司光耀", "content": "圣女的同步率在中断时是多少？", "emotionStrength": 0.15, "matchedPanel": {"storyboardId": "clip-10", "panelIndex": 3}},
  {"lineIndex": 80, "speaker": "大祭司光耀", "content": "三十天。找到她。活着带回来。至于零号频率——如果无法活捉——消灭。", "emotionStrength": 0.2, "matchedPanel": {"storyboardId": "clip-10", "panelIndex": 4}},
  {"lineIndex": 81, "speaker": "旁白", "content": "他们不信任彼此。他们不了解彼此。他们甚至不确定明天能不能活下来。但在这一刻——在曙光城的灯光和教团的追兵和整个世界都被甩在身后的这一刻——他们是彼此唯一的同伴。", "emotionStrength": 0.1, "matchedPanel": {"storyboardId": "clip-10", "panelIndex": 6}},
  {"lineIndex": 82, "speaker": "旁白", "content": "在那幅画的最深处，属于零号频率的故事刚刚开始。", "emotionStrength": 0.1, "matchedPanel": {"storyboardId": "clip-10", "panelIndex": 7}}
]
